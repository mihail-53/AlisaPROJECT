<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helper="clr-namespace:AlisaPROJECT.Helper"
             x:Class="AlisaPROJECT.Views.LoginPage"
             Title="LoginPage"
             Style="{x:StaticResource AuthBackground}">
    <VerticalStackLayout>
        <Grid RowDefinitions="*, auto, auto" Margin="10">
            <Label 
                Text="Log In"
                 VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Grid.Row="0"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="10" Spacing="10">
                    <Label Text="Enter Email:"/>
                    <Entry Placeholder="Email" x:Name="emailEntry"/>
                    <Label Text="" x:Name="errLoginEmail" TextColor="Red"/>

                    <Label Text="Enter Password:"/>
                    <Grid ColumnDefinitions="*, 75">
                        <Entry Placeholder="Password" IsPassword="True" x:Name="passwordEntry" Grid.Column="0"/>
                        <Button Grid.Column="1" FontFamily="Material" Text="{x:Static helper:IconFont.Visibility }" Clicked="OnShowPasswordClicked" x:Name="showButton" />
                    </Grid>
                    <Label Text="" x:Name="errLoginPassword" TextColor="Red"/>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="10" Spacing="10">
                <Button Text="Don't have an account? Sign Up"  Clicked="goToSignUpClicked" />
                <Button Text="Log In" Clicked="loginClicked" />
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>